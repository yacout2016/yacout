# =====================================================================
# GRIFFINE — .htaccess (الإصدار 84) — حماية ملفات السيرفر + رؤوس أمان
# =====================================================================

# 1) منع عرض محتوى الفولدرات
Options -Indexes

# 2) منع تحميل الملفات الحساسة مباشرة من الرابط:
#    ملفات SQL والتوثيق وملف الأسرار (لو اترفع جوه الموقع) والسجلات والنسخ الاحتياطية
<FilesMatch "(?i)(\.(sql|md|log|bak|ini|env|sh|zip|xlsx?|csv)$|^griffine_config(\.sample)?\.php$|^\.)">
    Require all denied
</FilesMatch>

# 3) ملفات مساعدة PHP مبتتفتحش لوحدها (بيستخدمها الكود من جوه بس)
<FilesMatch "^(db|mailer|uploads|session_boot|chat_read_state|chat_notify_lib|plans_store|otp_lib|paymob_lib|security_lib|quote_lib|markets_lib|trades_lib|chat_faq_lib|trash_lib|codes_lib|markets_core|symbols_lib|notify_lib|opps_lib|ai_access_lib|basira_lib|mizan_lib|mizanai_lib|mizanai_rates_lib|perks_lib|rate_lib|recs_lib)\.php$">
    Require all denied
</FilesMatch>

# 4) فولدر المرفوعات لو اتعمل جوه الموقع (الملفات بتتعرض عن طريق file_get.php بس)
RedirectMatch 403 ^/griffine_uploads/
RedirectMatch 403 ^/griffine_sessions/

# 5) رؤوس أمان لكل الصفحات
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 5ب) الإصدار 147: حماية CSP للصفحة الرئيسية من هنا كمان (لأن إعدادات الاستضافة كانت بتستبدل اللي بيبعته index.php)
<IfModule mod_headers.c>
    <Files "index.php">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://s3.tradingview.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; frame-src https://s.tradingview.com https://www.tradingview.com https://*.tradingview.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
    </Files>
</IfModule>

# 5ج) الإصدار 150: منع برامج تنزيل / نسخ المواقع كاملة وبوتات سحب البيانات (جوجل وفيسبوك وواتساب وتيك توك مسموحين عادي)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|WebCopier|WebCopy|WebZIP|Offline\ Explorer|SiteSucker|Teleport|WebStripper|WebReaper|BlackWidow|SiteSnagger|WebSauger|Website\ Quester|python-requests|Scrapy|aiohttp|Go-http-client|libwww-perl|MJ12bot|AhrefsBot|SemrushBot|DotBot|PetalBot|DataForSeoBot|BLEXBot|serpstatbot) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 6) تحويل أي زيارة http إلى https
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} ^(www\.)?griffine\.store$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
